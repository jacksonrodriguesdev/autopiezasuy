# Stripe (links de pagamento: Admin → Pagamentos). Coloque os valores só no hPanel, nunca no git.
# STRIPE_SECRET_KEY = sk_test_... (teste) ou sk_live_... (produção)
# STRIPE_WEBHOOK_SECRET = whsec_... (Developers → Webhooks → endpoint /api/public/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_MOEDA = (vazio) conta brasileira: cobra sempre em R$ (link em $U convertido pela cotação)
#                MULTI: conta que cobra em várias moedas (cliente escolhe pesos ou dólares)
STRIPE_MOEDA=

# Cloudflare R2: envio das fotos (scripts/catalogo/enviar_fotos_r2.cjs). Só no PC, nunca no git.
